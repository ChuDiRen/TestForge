# ===== 部署环境 =====
# dev（默认，宽松）/ prod（启动时强制安全检查：默认 SECRET_KEY/ADMIN_PASSWORD 直接拒启）
ENV=dev

# ===== 数据库 =====
# docker-compose 部署时使用（服务名互访）
DATABASE_URL=postgresql+psycopg://testforge:testforge@postgres:5432/testforge
REDIS_URL=redis://redis:6379/0

# ===== LLM（核心：公司落地必读）=====
# 生成管线会把仓库源码发给 LLM——公司内使用必须保证代码不出域，二选一：
#
# 方案 A（推荐）：公司内部 LLM 网关 / 私有化部署（vLLM 起 DeepSeek/Qwen，
#   OpenAI 兼容接口即可），把 LLM_BASE_URL 指向内部地址：
#   LLM_BASE_URL=http://llm-gateway.internal:8000/v1
#   LLM_MODEL=deepseek-v3
#
# 方案 B：DeepSeek 官方云 API（仅限非敏感代码/已获审批场景）：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# 角色路由（可选）：extract=抽取摘要 / query=最终生成 / keyword=检索词，
# 空 = 全部回退 LLM_MODEL。生成质量优先时 query 用更强模型。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_MODEL_EXTRACT=
LLM_MODEL_QUERY=
LLM_MODEL_KEYWORD=

# ===== 沙箱 =====
# local = 本机子进程（开发）；生产必须 docker（真实容器 --network none / 512m / 1cpu）
SANDBOX_MODE=local

# ===== 安全 =====
# 生产（ENV=prod）必改：默认值会被启动检查拒启
SECRET_KEY=testforge-local-secret
ADMIN_PASSWORD=testforge-admin
# 仓库接入是否允许本地路径：生产必须关闭（默认 false）
ALLOW_LOCAL_REPO_URL=false

LOG_LEVEL=INFO
GATEWAY_PORT=8000
FRONTEND_PORT=5173
GRPC_TIMEOUT_S=10
