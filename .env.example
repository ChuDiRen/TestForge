# docker-compose 部署时使用（服务名互访）
DATABASE_URL=postgresql+psycopg://testforge:testforge@postgres:5432/testforge
REDIS_URL=redis://redis:6379/0
# LLM: real=OpenAI 兼容 API；mock=固定样例（无 Key 全流程可跑）
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
# SANDBOX: docker=真实容器(--network none/512m/1cpu)；fake=假执行器
SANDBOX_MODE=fake
LOG_LEVEL=INFO
GATEWAY_PORT=8000
FRONTEND_PORT=5173
GRPC_TIMEOUT_S=10
